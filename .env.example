# GitHub OAuth Configuration
# Get these from: https://github.com/settings/developers
GITHUB_ID=your_github_oauth_app_id_here
GITHUB_SECRET=your_github_oauth_secret_here

# Razorpay Payment Gateway Configuration
# Get these from: https://dashboard.razorpay.com/app/settings/api-keys
KEY_ID=your_razorpay_key_id_here
KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
NEXT_PUBLIC_KEY_ID=your_public_razorpay_key_id_here

# NextAuth Configuration
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Application URLs
URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000

# For production, update these to your deployed domain:
# NEXTAUTH_URL=https://your-domain.vercel.app
# NEXT_PUBLIC_URL=https://your-domain.vercel.app
